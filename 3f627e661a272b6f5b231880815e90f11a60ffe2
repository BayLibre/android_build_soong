      "writtenOn": "2024-05-02T23:13:42Z",
      "side": 1,
      "message": "system/sepolicy/Android.bp has some good examples of `installable: false` modules. They are totally unrelated with the path conflicts.",
      "parentUuid": "7243f736_c8dbf6f5",
      "revId": "3f627e661a272b6f5b231880815e90f11a60ffe2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
