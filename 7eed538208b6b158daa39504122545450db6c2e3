      "message": "+hansson for the mention in the last comment.",
      "revId": "7eed538208b6b158daa39504122545450db6c2e3",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "6c17bca1_3778dc18",
