      "writtenOn": "2024-05-06T22:18:59Z",
      "side": 1,
      "message": "Ah, I missed that `android.GlobFiles` covnerted it to a module path.\n\nCan you try with `mctx.GlobWithDeps()` instead?  That will return strings instead of Paths.",
      "parentUuid": "bad67b62_142e9daf",
      "revId": "1eefef3b6107db6c8c0f6ce0fed492a68e8f376b",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
