      "writtenOn": "2021-04-07T03:39:24Z",
      "side": 1,
      "message": "Will be useful to have a test that mimics the behavior in libc_headers_arch where the arch-specific glob is subtracted away because it exists in the base list.",
      "range": {
        "startLine": 161,
        "startChar": 12,
        "endLine": 161,
        "endChar": 51
      },
      "revId": "50acbd5b40602eacad36b58efa74ca73cd638275",
