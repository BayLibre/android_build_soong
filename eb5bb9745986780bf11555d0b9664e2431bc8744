      "writtenOn": "2023-02-24T12:14:03Z",
      "side": 1,
      "message": "This should go before the recursive call on line 147, otherwise there\u0027s nothing to stop endless recursion.\n\nCan we add a test for this and observe endless loop before the fix?",
      "range": {
        "startLine": 149,
        "startChar": 0,
        "endLine": 149,
        "endChar": 23
      },
