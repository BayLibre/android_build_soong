    {
      "unresolved": false,
      "key": {
        "uuid": "35883dbe_d4ab2c57",
        "filename": "java/dexpreopt_config.go",
        "patchSetId": 2
      },
      "lineNbr": 149,
      "author": {
        "id": 1884045
      },
      "writtenOn": "2023-02-24T12:32:02Z",
      "side": 1,
      "message": "I think it is correct that this line should go here. We shouldn\u0027t support boot image configs that form an endless loop. For example, if A extends B, B extends C, C extends A, then this code is expected to encounter a stack overflow and fail.\n\nIf I move this line before line 147, then in the endless loop case above, this code will success and produce wrong results. That\u0027s not the desired behavior.",
      "parentUuid": "459bea5d_68c4d1cb",
      "range": {
        "startLine": 149,
        "startChar": 0,
        "endLine": 149,
        "endChar": 23
      },
      "revId": "eb5bb9745986780bf11555d0b9664e2431bc8744",
