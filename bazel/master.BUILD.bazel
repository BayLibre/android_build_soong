load("//build/soong/bazel/rules:gcc_toolchain.bzl", "gcc_toolchain")
# Legacy system files needed to build with bionic as libc.
# Once bionic is built with Bazel these can be removed.
load("//build/soong/bazel/rules:static_libc.bzl", "static_libc")
load("//build/soong/bazel/rules:platform_sdk_version.bzl", "platform_sdk_version")
load("//build/soong/bazel:ninja_structure.bzl", "UNRESOLVED_SYMLINKS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "prebuilts/build-tools/linux-x86/bin/xz",
    "prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9/lib/gcc/aarch64-linux-android/4.9.x/libgcc.a",
    "prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9/lib/gcc/arm-linux-androideabi/4.9.x/libgcc.a",
    "prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9/lib/gcc/x86_64-linux-android/4.9.x/libgcc.a",
    "prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9/lib/gcc/x86_64-linux-android/4.9.x/32/libgcc.a",
])

# Gcc toolchain binding
toolchain_type(name = "gcc_toolchain_type")

gcc_toolchain(name = "gcc_toolchain_x86_64",
    nm = "prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9/bin/x86_64-linux-android-nm",
    objcopy = "prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9/bin/x86_64-linux-android-objcopy",
    readelf = "prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9/bin/x86_64-linux-android-readelf"
)

toolchain(name = "gcc_toolchain_x86_64_def",
    exec_compatible_with = [
        "@bazel_tools//platforms:x86_64",
        "@bazel_tools//platforms:linux",
    ],
    target_compatible_with = [
        "@bazel_tools//platforms:x86_64",
        "@bazel_tools//platforms:android",
    ],
    toolchain = ":gcc_toolchain_x86_64",
    toolchain_type = ":gcc_toolchain_type",
)

gcc_toolchain(name = "gcc_toolchain_x86_32",
    nm = "prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9/bin/x86_64-linux-android-nm",
    objcopy = "prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9/bin/x86_64-linux-android-objcopy",
    readelf = "prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9/bin/x86_64-linux-android-readelf"
)

toolchain(name = "gcc_toolchain_x86_def",
    exec_compatible_with = [
        "@bazel_tools//platforms:x86_64",
        "@bazel_tools//platforms:linux",
    ],
    target_compatible_with = [
        "@bazel_tools//platforms:x86_32",
        "@bazel_tools//platforms:android",
    ],
    toolchain = ":gcc_toolchain_x86_32",
    toolchain_type = ":gcc_toolchain_type",
)

gcc_toolchain(name = "gcc_toolchain_arm64",
    nm = "prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9/bin/aarch64-linux-android-nm",
    objcopy = "prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9/bin/aarch64-linux-android-objcopy",
    readelf = "prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9/bin/aarch64-linux-android-readelf"
)

toolchain(name = "gcc_toolchain_arm64_def",
    exec_compatible_with = [
        "@bazel_tools//platforms:x86_64",
        "@bazel_tools//platforms:linux",
    ],
    target_compatible_with = [
        "@bazel_tools//platforms:aarch64",
        "@bazel_tools//platforms:android",
    ],
    toolchain = ":gcc_toolchain_arm64",
    toolchain_type = ":gcc_toolchain_type",
)

gcc_toolchain(name = "gcc_toolchain_arm",
    nm = "prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9/bin/arm-linux-androideabi-nm",
    objcopy = "prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9/bin/arm-linux-androideabi-objcopy",
    readelf = "prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9/bin/arm-linux-androideabi-readelf"
)

toolchain(name = "gcc_toolchain_arm_def",
    exec_compatible_with = [
        "@bazel_tools//platforms:x86_64",
        "@bazel_tools//platforms:linux",
    ],
    target_compatible_with = [
        "@bazel_tools//platforms:arm",
        "@bazel_tools//platforms:android",
    ],
    toolchain = ":gcc_toolchain_arm",
    toolchain_type = ":gcc_toolchain_type",
)

# The current default value for PLATFORM_SDK_VERSION.
# TODO(b/147667747): Replace this with a build setting, probably from the command line.
platform_sdk_version(
    name = "default_platform_sdk_version",
    version = 29,  # Matches value from //build/make/core/version_defaults.mk:115
)

config_setting(
    name = "use_legacy_bionic",
    define_values = {
        "legacy_bionic": "true",
    },
)

alias(
    name = "bionic",
    actual = select({
        ":use_legacy_bionic": ":legacy_bionic",
        "//conditions:default": ":full_bionic",
    }),
)
cc_import(
    name = "libgcc",
    static_library = select({
        "//build/soong/bazel/devices:config_arm64": "prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9/lib/gcc/aarch64-linux-android/4.9.x/libgcc.a",
        "//build/soong/bazel/devices:config_arm": "prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9/lib/gcc/arm-linux-androideabi/4.9.x/libgcc.a",
        "//build/soong/bazel/devices:config_x86_64": "prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9/lib/gcc/x86_64-linux-android/4.9.x/libgcc.a",
        "//build/soong/bazel/devices:config_x86": "prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9/lib/gcc/x86_64-linux-android/4.9.x/32/libgcc.a",
    }),
)

cc_library(
    name = "full_bionic",
    deps = [
        "//bionic/libc:crtbegin",
        "//bionic/libc:crtend",
        "//external/libcxx",
        "//bionic/libc",
        "//bionic/libdl",
        "//bionic/libm",
        ":libgcc",
    ],
)

# Alias target for the legacy bionic lib.
alias(
    name = "legacy_bionic",
    actual = select(
        {
            "//build/soong/bazel/devices:config_x86_64": ":legacy_bionic_x86_64_library",
            "//build/soong/bazel/devices:config_x86": ":legacy_bionic_x86_32_library",
            "//build/soong/bazel/devices:config_arm64": ":legacy_bionic_arm64_library",
            "//build/soong/bazel/devices:config_arm": ":legacy_bionic_arm_library",
        },
        no_match_error = "Whoops, no match!",
    ),
)

