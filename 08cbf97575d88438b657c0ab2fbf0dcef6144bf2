      "unresolved": true
    },
    {
      "key": {
        "uuid": "db916c1a_00cd537a",
        "filename": "cc/prebuilt.go",
        "patchSetId": 3
      },
      "lineNbr": 349,
      "author": {
        "id": 1373864
      },
      "writtenOn": "2020-09-03T16:27:55Z",
      "side": 1,
      "message": "Sorry, I don\u0027t follow. The only symlink the build system needs to create to run the binary in that example is out/host/linux-x86/bin/prebuilt-with-symlink. Then the binary will load the shared libs directly from their source locations.\n\nIf a shared lib is updated but not the binary then these dependencies on the .intermediates copies along with their dependencies back to the prebuilt libs will make any dependency on the binary module behave correctly. I\u0027m rigging something up to try this.",
      "parentUuid": "8881e321_7ff5efdc",
      "range": {
        "startLine": 349,
        "startChar": 6,
        "endLine": 349,
        "endChar": 40
      },
      "revId": "08cbf97575d88438b657c0ab2fbf0dcef6144bf2",
