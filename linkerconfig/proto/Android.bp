cc_library_static {
    name: "lib_linker_config_proto_lite",
    host_supported: true,
    recovery_available: true,
    proto: {
        export_proto_headers: true,
        type: "lite",
    },
    srcs: ["linker_config.proto"],
}

python_binary_host {
    name: "conv_linker_config",
    srcs: [
        "conv_linker_config.py",
        "linker_config.proto",
    ],
    version: {
        py2: {
            enabled: false,
        },
        py3: {
            enabled: true,
            embedded_launcher: true,
        },
    },
}
