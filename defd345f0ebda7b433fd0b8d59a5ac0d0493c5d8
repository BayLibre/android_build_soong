      "writtenOn": "2021-05-12T21:20:09Z",
      "side": 1,
      "message": "Ack. That is outside the scope of this change.",
      "parentUuid": "1958a553_174ff58f",
      "range": {
        "startLine": 7,
        "startChar": 0,
        "endLine": 7,
        "endChar": 38
      },
      "revId": "defd345f0ebda7b433fd0b8d59a5ac0d0493c5d8",
