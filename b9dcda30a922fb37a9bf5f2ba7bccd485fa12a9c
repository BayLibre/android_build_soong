      "writtenOn": "2021-01-12T06:01:50Z",
      "side": 1,
      "message": "Can we make it work? i.e. \"vendor_available: true \u0026\u0026 device_specific: true\" will install the vendor variant to the odm partition.",
      "range": {
        "startLine": 12,
        "startChar": 0,
        "endLine": 12,
        "endChar": 37
      },
      "revId": "b9dcda30a922fb37a9bf5f2ba7bccd485fa12a9c",
