        "id": 1146974
      },
      "writtenOn": "2021-01-13T08:16:28Z",
      "side": 1,
      "message": "I got an answer from the partner that they need to create both core and vendor variants for the hidl interface.\nSo `device_specific: true` will not work to solve it.",
      "parentUuid": "572b444b_442239c8",
      "range": {
        "startLine": 12,
        "startChar": 0,
        "endLine": 12,
        "endChar": 37
      },
