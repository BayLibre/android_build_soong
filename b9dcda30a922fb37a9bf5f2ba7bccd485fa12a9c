      "writtenOn": "2021-01-12T08:06:33Z",
      "side": 1,
      "message": "Good point.\nAFAIK, hidl_interfaces requires a core variant for VTS.\n\nSteven, can we exempt the VTS for device_specific hidl_interface?",
      "parentUuid": "8a14385d_6a05108f",
      "range": {
        "startLine": 12,
        "startChar": 0,
        "endLine": 12,
        "endChar": 37
      },
      "revId": "b9dcda30a922fb37a9bf5f2ba7bccd485fa12a9c",
