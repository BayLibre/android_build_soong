{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch",
            "type": "go",
            "request": "launch",
            // "mode": "auto",
            // "program": "${workspaceFolder}/cmd/soong_build/main.go",
            "mode": "exec",
            "program": "${workspaceFolder}/../../out/soong/.bootstrap/bin/soong_build",
            "preLaunchTask": "build-debug",
            "linux": {
                "env": {
                    "ANDROID_JAVA8_HOME": "prebuilts/jdk/jdk8/linux-x86",
                    "ANDROID_JAVA9_HOME": "prebuilts/jdk/jdk9/linux-x86"
                }
            },
            "args": [
                "-t",
                "-l",
                "out/.module_paths/Android.bp.list",
                "-b",
                "out/soong",
                "-n",
                "out",
                "-o",
                "out/soong/build.ninja",
                "./Android.bp"
            ],
            "cwd": "${workspaceFolder}/../../"
        }
    ]
}