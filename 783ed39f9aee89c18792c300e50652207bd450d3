    {
      "key": {
        "uuid": "115ddeaf_8355dff7",
        "filename": "java/sdk_library.go",
        "patchSetId": 1
      },
      "lineNbr": 1325,
      "author": {
        "id": 1039338
      },
      "writtenOn": "2020-05-27T16:10:57Z",
      "side": 1,
      "message": "I think this check should only be active when sdk_version is not specified.\n\nThere are good reasons for allowing access to the implementation from within the same APEX and that is safe to do so and this flag would prevent that access. That would mean that this flag could not be used any java_sdk_library that requires impl access within the same APEX (which is safe) but would mean that it was possible to use the impl from outside the APEX which is unsafe.\n\nA simple way to achieve that is to revert this change and then move the if statement below above this so that if the new property is set the sdkVersion will be module_current by the time it gets to this code so will not return the implementation path unless it is in the same APEX.",
      "revId": "783ed39f9aee89c18792c300e50652207bd450d3",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
