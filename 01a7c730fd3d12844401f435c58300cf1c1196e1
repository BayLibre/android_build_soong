      "writtenOn": "2020-03-26T12:51:26Z",
      "side": 1,
      "message": "I think this should be moved out of loop:\n  imageLocations :\u003d current.imageLocations()\n\nBut see also the comment regarding caching imageLocations in a field in the config; then maybe the changes in this function can be avoided at all.",
      "range": {
        "startLine": 628,
        "startChar": 0,
        "endLine": 630,
        "endChar": 5
      },
      "revId": "01a7c730fd3d12844401f435c58300cf1c1196e1",
