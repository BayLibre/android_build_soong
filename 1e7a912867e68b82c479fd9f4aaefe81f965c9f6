    {
      "key": {
        "uuid": "52823e87_627a30b0",
        "filename": "android/prebuilt.go",
        "patchSetId": 2
      },
      "lineNbr": 236,
      "author": {
        "id": 1039338
      },
      "writtenOn": "2020-03-16T15:58:04Z",
      "side": 1,
      "message": "On one path to this method it is checked (as it is an error if it is not set) but on the other path to this method it is not checked and could be set. At least that is how the previous code behaved and tests fail if this check is not present.",
      "parentUuid": "3225882f_b1bcbf83",
      "range": {
        "startLine": 236,
        "startChar": 4,
        "endLine": 236,
        "endChar": 25
      },
      "revId": "1e7a912867e68b82c479fd9f4aaefe81f965c9f6",
