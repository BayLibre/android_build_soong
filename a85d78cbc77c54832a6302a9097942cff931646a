    },
    {
      "unresolved": true,
      "key": {
        "uuid": "95e7a223_1c8e7459",
        "filename": "android/visibility.go",
        "patchSetId": 1
      },
      "lineNbr": 486,
      "author": {
        "id": 1039338
      },
      "writtenOn": "2022-10-19T17:28:35Z",
      "side": 1,
      "message": "\u003e Introducing multiple paths for checking visibility introduces more chance for skew between the two.\n\nFixed. Refactored the mutator to use DepIsVisible.\n\n\u003e This type of additional check is also not something we will be able to support within Bazel\n\nIn Bazel you will not have both embedded \u003cX\u003e and separate \u003cX.impl\u003e implementation libraries so you will not need to do this. I hope that you will have a separate \u003cX.impl\u003e library so that you can support impl_library_visibility (or something like it) because that is important functionality but there will be no need to support embedded \u003cX\u003e.\n\n\u003e this would introduce this API to everyone, including plugins, because of that, I\u0027m disinclined to support this.\n\nJust because some plugin may abuse this (which is highly unlikely) is not a reason for not adding this functionality. You could use that argument to avoid adding any new exports at all.\n\nThis functionality is needed to ensure that the embedded \u003cX\u003e and \u003cX\u003e.impl libraries are handled consistently so that when we eliminate the embedded library (if not in Soong then when migrating to Bazel) that we do not have to deal with this sort of clean up.",
      "parentUuid": "1a7b8bfc_7ed68967",
      "range": {
        "startLine": 483,
        "startChar": 0,
        "endLine": 486,
        "endChar": 2
      },
      "revId": "a85d78cbc77c54832a6302a9097942cff931646a",
