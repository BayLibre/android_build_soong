      "writtenOn": "2024-11-25T21:03:29Z",
      "side": 1,
      "message": "Thanks for adding me!  The dm-verity salt avoids forever-lived block hashes which open the door to hash collisions against what would otherwise be authenticated data on disk.  Updating the salt once per release should be more than enough.\n\nI\u0027ve added more flavor in the change.",
      "parentUuid": "c2ead18a_ebadbaa0",
      "revId": "02001848b36a8ee1011c9daabcc9fa0f5e22f12d",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
