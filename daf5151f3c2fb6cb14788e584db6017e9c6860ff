    {
      "key": {
        "uuid": "e7280208_9ebc01d1",
        "filename": "ui/build/config.go",
        "patchSetId": 3
      },
      "lineNbr": 67,
      "author": {
        "id": 1074628
      },
      "writtenOn": "2017-02-03T23:24:49Z",
      "side": 1,
      "message": "We don\u0027t have any consistent python guidance right now, there\u0027s a mix of 2\u00263, and no enforcement of versions within those. I expect this will get better once we\u0027ve got real python packaging support, but even then I don\u0027t know if we\u0027ll be able to move everyone to 3. Even with 3, it looks like __pycache__ just replaces the .pyc in the same relative location, which doesn\u0027t help when we don\u0027t want to write to the source directory at all.\n\nThis comment is copied from build/make/core/config.mk (originally added in 2010).",
      "parentUuid": "f4862bdb_2c9fcf31",
      "revId": "daf5151f3c2fb6cb14788e584db6017e9c6860ff",
