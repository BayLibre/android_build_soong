package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

bootstrap_go_package {
    name: "soong-fuzz",
    pkgPath: "android/soong/fuzz",
    deps: [
        "blueprint",
        "blueprint-pathtools",
        "soong",
        "soong-android",
        "soong-bazel",
        "soong-etc",
        "soong-genrule",
        "soong-tradefed",
    ],
    srcs: [
        "fuzz_common.go",
    ],
    pluginFor: ["soong_build"],
}
