    },
    {
      "key": {
        "uuid": "08704f4b_34d72118",
        "filename": "android/api_levels.go",
        "patchSetId": 6
      },
      "lineNbr": 231,
      "author": {
        "id": 1043845
      },
      "writtenOn": "2020-08-13T22:06:07Z",
      "side": 1,
      "message": "How does that work? When 30 drops into the platform, do all the cases of \"R\" become build failures, or do they just continue targeting the preview? I can change this behavior easy enough if I need to.",
      "parentUuid": "3d424a92_7f0cde61",
      "range": {
        "startLine": 224,
        "startChar": 0,
        "endLine": 231,
        "endChar": 2
      },
      "revId": "eceaa0242ca5e36a9e0309017d89444a5c38e4da",
