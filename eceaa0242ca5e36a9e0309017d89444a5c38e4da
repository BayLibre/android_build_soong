        "id": 1002751
      },
      "writtenOn": "2020-08-13T23:33:03Z",
      "side": 1,
      "message": "We never use \"R\" in an Android.bp or Android.mk file, we always use \"current\", which magically changes from \"R\" to \"30\" when R is finalized, and then to \"S\" in master.",
      "parentUuid": "08704f4b_34d72118",
      "range": {
        "startLine": 224,
        "startChar": 0,
        "endLine": 231,
        "endChar": 2
      },
      "revId": "eceaa0242ca5e36a9e0309017d89444a5c38e4da",
