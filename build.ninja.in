# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # #
# Singleton: bootstrap
# Factory:   github.com/google/blueprint/bootstrap.func·008

rule s.bootstrap.bigbpDocs
    command = ${g.bootstrap.BinDir}/soong_build  -t -b ${g.bootstrap.buildDir} --docs ${out} ${g.bootstrap.srcDir}/Android.bp
    description = soong_build docs ${out}

rule s.bootstrap.bigbp
    command = ${g.bootstrap.BinDir}/soong_build  -t -b ${g.bootstrap.buildDir} -d ${g.bootstrap.buildDir}/.bootstrap/main.ninja.in.d -m ${g.bootstrap.bootstrapManifest} -o ${out} ${in}
    depfile = ${g.bootstrap.buildDir}/.bootstrap/main.ninja.in.d
    description = soong_build ${out}

rule s.bootstrap.minibp
    command = ${g.bootstrap.BinDir}/minibp ${runTests} -c ${checkFile} -m ${g.bootstrap.bootstrapManifest} -b ${g.bootstrap.buildDir} -d ${out}.d -o ${out} ${in}
    depfile = ${out}.d
    description = minibp ${out}
    generator = true

build ${g.bootstrap.buildDir}/.bootstrap/docs/soong_build.html: $
        s.bootstrap.bigbpDocs | ${g.bootstrap.BinDir}/soong_build
default ${g.bootstrap.buildDir}/.bootstrap/docs/soong_build.html
build ${g.bootstrap.buildDir}/.bootstrap/main.ninja.in: s.bootstrap.bigbp $
        ${g.bootstrap.srcDir}/Android.bp | ${g.bootstrap.BinDir}/androidbp $
        ${g.bootstrap.BinDir}/androidmk ${g.bootstrap.BinDir}/bpfmt $
        ${g.bootstrap.BinDir}/bpmodify ${g.bootstrap.BinDir}/gotestmain $
        ${g.bootstrap.BinDir}/minibp ${g.bootstrap.BinDir}/soong_build $
        ${g.bootstrap.BinDir}/soong_env ${g.bootstrap.BinDir}/soong_glob $
        ${g.bootstrap.BinDir}/soong_jar $
        ${g.bootstrap.buildDir}/.bootstrap/docs/soong_build.html
default ${g.bootstrap.buildDir}/.bootstrap/main.ninja.in
build ${g.bootstrap.buildDir}/.bootstrap/notAFile: phony
default ${g.bootstrap.buildDir}/.bootstrap/notAFile
build ${g.bootstrap.buildDir}/build.ninja: g.bootstrap.bootstrap $
        ${g.bootstrap.buildDir}/.bootstrap/main.ninja.in | $
        ${g.bootstrap.bootstrapCmd} $
        ${g.bootstrap.buildDir}/.bootstrap/notAFile $
        ${g.bootstrap.buildDir}/.bootstrap/bootstrap.ninja.in
default ${g.bootstrap.buildDir}/build.ninja
build ${g.bootstrap.buildDir}/.bootstrap/bootstrap.ninja.in: $
        s.bootstrap.minibp ${g.bootstrap.srcDir}/Android.bp | $
        ${g.bootstrap.BinDir}/minibp
    checkFile = ${g.bootstrap.bootstrapManifest}
    runTests = -t
default ${g.bootstrap.buildDir}/.bootstrap/bootstrap.ninja.in

