      "writtenOn": "2020-08-11T00:24:15Z",
      "side": 1,
      "message": "I wonder if this should be the other way around. min_sdk_version is required, sdk_version defaults to the value of min_sdk_version. \"sdk_version\" isn\u0027t intention revealing in the Android.bp file, whereas \"min_sdk_version\" is something you can understand without needing to look at the docs.",
      "range": {
        "startLine": 227,
        "startChar": 35,
        "endLine": 227,
        "endChar": 100
      },
      "revId": "b8ae8d5b034e4945d4217063b6a8046b22e526e1",
