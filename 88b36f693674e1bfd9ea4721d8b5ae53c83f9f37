      "writtenOn": "2022-05-19T22:47:32Z",
      "side": 1,
      "message": "This is best practice for ensuring that Module implements MixedBuildsBuildable.\n\nhttps://stackoverflow.com/a/27804417/5843554",
      "parentUuid": "ef4cfc5d_8a1c3be2",
      "revId": "88b36f693674e1bfd9ea4721d8b5ae53c83f9f37",
