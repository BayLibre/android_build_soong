      },
      "writtenOn": "2017-07-31T21:41:45Z",
      "side": 1,
      "message": "Use an unbuffered channel",
      "revId": "95fb00e63d8fb419928115fa1b4490681e21b913",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
