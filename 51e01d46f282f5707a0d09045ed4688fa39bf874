      "writtenOn": "2021-12-13T15:51:11Z",
      "side": 1,
      "message": "all the uses appear to be strings -- do we need to be this flexible?",
      "range": {
        "startLine": 69,
        "startChar": 46,
        "endLine": 69,
        "endChar": 57
      },
      "revId": "51e01d46f282f5707a0d09045ed4688fa39bf874",
