      "writtenOn": "2023-02-28T08:17:03Z",
      "side": 1,
      "message": "nit: any reason why these are lambdas and not functions with BazelProxyServer as the receiver?",
      "range": {
        "startLine": 172,
        "startChar": 1,
        "endLine": 172,
        "endChar": 15
      },
      "revId": "22031f853ab8c2d4636adec4fd50101f16126182",
