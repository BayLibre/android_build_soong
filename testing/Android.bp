package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

bootstrap_go_package {
    name: "soong-testing",
    pkgPath: "android/soong/testing",
    deps: [
        "blueprint",
        "soong-android",
        "soong-java",
        "soong-testing-test_run_proto",

    ],
    srcs: [
        "test_run.go",
        "all_test_run.go",
        "init.go",
        "test.go",
    ],
    testSrcs: [
                "test_run_test.go",
            ],
    pluginFor: ["soong_build"],
}
