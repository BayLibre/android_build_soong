      },
      "writtenOn": "2024-11-27T18:07:33Z",
      "side": 1,
      "message": "Intent: make sure that line 187 finishes before we exit the build.  Is there a better way to achieve that?",
      "parentUuid": "9bf945fa_cb21777f",
      "range": {
        "startLine": 189,
        "startChar": 0,
        "endLine": 193,
        "endChar": 2
