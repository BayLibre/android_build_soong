      },
      "writtenOn": "2015-04-08T22:52:30Z",
      "side": 1,
      "message": "Just moving the data into a blueprints file isn\u0027t that different from having it here.  I could create a new aidl exporter module type that lists these directories and gets added as an implicit dependency to aidl compiles, but I\u0027m not sure what that buys us over this.",
      "parentUuid": "03868e96_54654c44",
      "range": {
        "startLine": 38,
        "startChar": 2,
        "endLine": 53,
        "endChar": 29
      },
      "revId": "7f303e0e45e89bec04c2174bd65201d4c35a0bd7",
