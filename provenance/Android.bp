package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

bootstrap_go_package {
    name: "soong-provenance_metadata_proto",
    pkgPath: "android/soong/provenance/provenance_metadata_proto",
    deps: [
        "golang-protobuf-reflect-protoreflect",
        "golang-protobuf-runtime-protoimpl",
    ],
    srcs: [
        "provenance_metadata_proto/provenance_metadata.pb.go",
    ],
}

bootstrap_go_package {
    name: "soong-provenance",
    pkgPath: "android/soong/provenance",
    srcs: [
        "provenance_singleton.go",
    ],
    deps: [
        "soong-android",
        "soong-apex",
        "soong-provenance_metadata_proto",
    ],
    testSrcs: [
        "provenance_singleton_test.go",
    ],
    pluginFor: [
        "soong_build",
    ],
}
