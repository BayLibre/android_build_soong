        "id": 1373864
      },
      "writtenOn": "2021-09-27T13:47:53Z",
      "side": 1,
      "message": "Aren\u0027t the dex2oat commands with all their inputs and outputs known in Soong? At least it knows about the deapexed jars, but I\u0027m not well versed in all the rest.",
      "parentUuid": "f2c40351_fa661c8c",
      "range": {
        "startLine": 188,
        "startChar": 0,
        "endLine": 192,
        "endChar": 5
      },
      "revId": "204356f3b54be5936e152815a96d1e917022d077",
