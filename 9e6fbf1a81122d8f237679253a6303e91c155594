      "writtenOn": "2022-02-07T15:05:44Z",
      "side": 1,
      "message": "YOu meant restrict the set of explicit test cases to the subset or actually add a check to strictly support only the subset?",
      "parentUuid": "c1e4cc58_1f7d991d",
      "range": {
        "startLine": 27,
