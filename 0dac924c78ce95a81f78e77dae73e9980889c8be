      "writtenOn": "2021-09-30T11:58:54Z",
      "side": 1,
      "message": "It\u0027s a bit confusing that you have to use AndroidMkDataForTest here but AndroidMkEntriesForTest in the test for prebuilts. Is there a reason to not use the same thing for both tests?",
      "range": {
        "startLine": 8464,
        "startChar": 9,
        "endLine": 8464,
        "endChar": 38
      },
      "revId": "0dac924c78ce95a81f78e77dae73e9980889c8be",
