      "writtenOn": "2023-01-13T14:06:14Z",
      "side": 1,
      "message": "Users do not need to explicitly set it. Refer to aosp/2384532, this option is included in a default that will be controlled by a soong config variable which is then controlled by an environment variable that is set or unset in the module build shell script.",
      "parentUuid": "1ea4959e_9f1bccf8",
      "range": {
        "startLine": 392,
        "startChar": 0,
        "endLine": 394,
        "endChar": 11
