    {
      "unresolved": false,
      "key": {
        "uuid": "3ac4421a_895e712b",
        "filename": "java/bootclasspath.go",
        "patchSetId": 4
      },
      "lineNbr": 184,
      "author": {
        "id": 1039338
      },
      "writtenOn": "2021-04-28T21:06:21Z",
      "side": 1,
      "message": "It is really just a way to group properties relating to the normal apis, just like core_platform_api is a way to group properties relating to the core platform api. If I did add just Stub_libs then I would be unable to reuse the structure for use with core_platform_api. Instead I would have to add Core_platform_stub_libs.\n\nPast experience, e.g. with java_sdk_library, shows that this pattern does not extend well and you end up with a whole set of different prefixes, e.g. stub_..., impl_... which makes it hard to be consistent and reuse code.\n\nWhile I don\u0027t know that I will need additional properties in here I have designed it so that it will be easy to add them in if and when we need to do so.",
      "parentUuid": "31b04122_e90e3fd2",
      "range": {
        "startLine": 184,
        "startChar": 1,
        "endLine": 184,
        "endChar": 4
      },
      "revId": "02c6b3b1161c8d1e51818cc0cbe48ef27d9c85fe",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
