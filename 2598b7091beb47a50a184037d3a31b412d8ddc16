      "writtenOn": "2020-03-13T08:59:32Z",
      "side": 1,
      "message": "This file is duplicating a lot of functionality provided by the library_sdk_member.go file. Can you not just use that instead?",
      "revId": "2598b7091beb47a50a184037d3a31b412d8ddc16",
