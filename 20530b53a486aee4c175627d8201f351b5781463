        "id": 1373864
      },
      "writtenOn": "2021-04-26T16:26:22Z",
      "side": 1,
      "message": "Since this doesn\u0027t apply to core platform I think it\u0027d be preferable to have it in a property set parallel with core_platform{} rather than one level up. Maybe call it \"not_core_platform\" if we can\u0027t come up with a better name.",
      "range": {
        "startLine": 192,
        "startChar": 0,
        "endLine": 193,
        "endChar": 34
      },
      "revId": "20530b53a486aee4c175627d8201f351b5781463",
