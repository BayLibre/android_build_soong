    {
      "key": {
        "uuid": "5acf3a56_9766fd94",
        "filename": "cmd/soong_build/bazel_overlay.go",
        "patchSetId": 14
      },
      "lineNbr": 227,
      "author": {
        "id": 1514900
      },
      "writtenOn": "2020-08-17T04:39:45Z",
      "side": 1,
      "message": "Ok, having read https://cs.android.com/android/platform/superproject/+/master:build/soong/android/paths.go;l\u003d311-372;drc\u003dmaster, it looks like this will affect 3 kinds of android:\"path\" props:\n\n1) Globs. We can mechanically translate these expressions to `glob()` calls.\n2) Source file producers by directly reference another module with \":name\". This works similarly in Bazel, using default output groups for each target, so there\u0027s I don\u0027t think we need to handle this case specially.\n3) \":name{.tag}\" output files. We\u0027d probably need to mechanically translate these to explicit output groups for each generated rule shim.\n\nI think it\u0027s ok to leave these for later (especially case 3), since providers, when they are ready, would help greatly in this area.",
      "parentUuid": "cc084d0e_7ee70d20",
      "range": {
        "startLine": 225,
        "startChar": 0,
        "endLine": 227,
        "endChar": 3
      },
      "revId": "6abca59216029e60a0358731e0779c9475efc1c0",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
