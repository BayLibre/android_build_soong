    {
      "key": {
        "uuid": "9a05b319_ccccd5d6",
        "filename": "java/sdk_library.go",
        "patchSetId": 5
      },
      "lineNbr": 512,
      "author": {
        "id": 1039338
      },
      "writtenOn": "2020-05-18T08:18:30Z",
      "side": 1,
      "message": "Because we have three use cases:\n1) Shared libraries which provide both API and implementation library and can be used as a shared library in an App via \u003cuses-library\u003e. - shared_library: true, api_only: true.\n2) Generating API surfaces like ART core platform that do not require an implementation library to be installed (as it is special or handled elsewhere). api_only: true.\n3) Android framework modules like framework-wifi, framework-tethering that provide an API and implementation library but which cannot be used as a shared library. shared_library: false, api_only: false.",
      "parentUuid": "6d1f5692_1b962fc6",
      "range": {
        "startLine": 507,
        "startChar": 0,
        "endLine": 512,
        "endChar": 21
      },
      "revId": "e46500456163f49d4dd1822b80b861149343dd77",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
    {
      "key": {
