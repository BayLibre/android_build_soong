      "writtenOn": "2021-10-29T16:39:22Z",
      "side": 1,
      "message": "According to Bob\u0027s statements in your doc, we should only add a package module if the license is the same for all modules within the blueprint -- this function doesn\u0027t appear to verify the license is the same across modules",
      "range": {
        "startLine": 1451,
        "startChar": 5,
        "endLine": 1451,
        "endChar": 29
      },
      "revId": "2b2f38f5ca8f9e3fc217802df7616dfbfdaea8b6",
