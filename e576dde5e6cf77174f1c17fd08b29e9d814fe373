    {
      "unresolved": true,
      "key": {
        "uuid": "c4a8e302_a86f9e48",
        "filename": "android/sdk.go",
        "patchSetId": 3
      },
      "lineNbr": 795,
      "author": {
        "id": 1039338
      },
      "writtenOn": "2022-06-28T18:59:59Z",
      "side": 1,
      "message": "The default for PrebuiltsRequired would need to be true so this would require changes to every existing existing instance of this to add \"PrebuiltsRequired: true\". Having this as \"PrebuiltsNotRequired\" means its default can be false so less changes are required.\n\nThe rest of the code is insulated from having to deal with things like !PrebuiltsNotRequired as the method for accessing is \"ArePrebuiltsRequired\".\n\nI could switch it to PrebuiltsRequired *bool and then treat nil as true. That would be inconsistent with other fields in this structure and require use of proptools.BoolPtr(false) but it is doable.",
      "parentUuid": "4b17dcdb_6c888898",
      "range": {
        "startLine": 795,
        "startChar": 10,
