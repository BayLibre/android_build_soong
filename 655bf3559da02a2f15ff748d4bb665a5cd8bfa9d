      "message": "This looks as though it could be replaced by the boot_image module once I have got that into a better state.",
      "revId": "655bf3559da02a2f15ff748d4bb665a5cd8bfa9d",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
