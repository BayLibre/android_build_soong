        "id": 1002751
      },
      "writtenOn": "2019-10-01T17:06:30Z",
      "side": 1,
      "message": "Does the value affect debugging?  For C++ we want the debug paths to be relative so that gdb run from $ANDROID_BUILD_TOP can find the source files.",
      "parentUuid": "f04388c8_186be27c",
      "range": {
        "startLine": 41,
        "startChar": 31,
        "endLine": 41,
        "endChar": 40
      },
      "revId": "917ceeea8085fa674a2abd89d4ea52b79671e5a2",
