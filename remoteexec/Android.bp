package {
    default_applicable_licenses: ["build_soong_license"],
}

bootstrap_go_package {
    name: "soong-remoteexec",
    pkgPath: "android/soong/remoteexec",
    deps: [
        "blueprint",
        "soong-android",
    ],
    srcs: [
        "remoteexec.go",
    ],
    testSrcs: [
        "remoteexec_test.go",
    ],
    pluginFor: ["soong_build"],
}
