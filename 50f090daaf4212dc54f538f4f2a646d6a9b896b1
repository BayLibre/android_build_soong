      "writtenOn": "2020-05-18T04:11:09Z",
      "side": 1,
      "message": "The build system could detect if they belong to the same APEX or not and then redirect the dependency to the impl library in that case.",
      "range": {
        "startLine": 21,
        "startChar": 0,
        "endLine": 22,
        "endChar": 11
      },
      "revId": "50f090daaf4212dc54f538f4f2a646d6a9b896b1",
