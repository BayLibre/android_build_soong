      "author": {
        "id": 1373864
      },
      "writtenOn": "2021-09-21T01:02:02Z",
      "side": 1,
      "message": "Can\u0027t this just be the implementation type right away? It doesn\u0027t have other implementations afaics.",
      "range": {
        "startLine": 431,
        "startChar": 23,
        "endLine": 431,
        "endChar": 32
      },
      "revId": "f491d40d0617b3e06a4ac70a259d9481bcbf20c2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
