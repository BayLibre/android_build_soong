              "replacement": "\n\t\t\tm[dstPath] \u003d ps\n\t\t}\n\t})\n\treturn m\n}\n\n// See PackageModule.GatherFilteredPackagingSpecs\nfunc (p *PackagingBase) GatherFilteredPackagingSpecs(ctx ModuleContext) map[string]PackagingSpec {\n\tpm :\u003d ctx.Module().(PackageModule)\n\tm :\u003d make(map[string]PackagingSpec)\n\tctx.VisitDirectDeps(func(child Module) {\n\t\tif pi, ok :\u003d ctx.OtherModuleDependencyTag(child).(PackagingItem); !ok || !pi.IsPackagingItem() {\n\t\t\treturn\n\t\t}\n\t\tfor _, ps :\u003d range child.TransitivePackagingSpecs() {\n\t\t\tif !pm.FilterPackagingSpec(\u0026ps) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tdstPath :\u003d ps.relPathInPackage\n\t\t\tif existingPs, ok :\u003d m[dstPath]; ok {\n\t\t\t\tsameSrc :\u003d existingPs.srcPath \u003d\u003d ps.srcPath\n\t\t\t\tsameSymlink :\u003d existingPs.symlinkTarget \u003d\u003d ps.symlinkTarget\n\t\t\t\tif !sameSrc || !sameSymlink {\n\t\t\t\t\tctx.ModuleErrorf(\"packaging conflict at %v:\\n%v\\n%v\", dstPath, existingPs, ps)\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t}\n"
