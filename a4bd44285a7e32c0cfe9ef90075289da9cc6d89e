      "side": 1,
      "message": "Android lint command lint has the (--check) option to only run certain checkers, is it still available?",
      "parentUuid": "e7009927_76672cf2",
      "revId": "a4bd44285a7e32c0cfe9ef90075289da9cc6d89e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
