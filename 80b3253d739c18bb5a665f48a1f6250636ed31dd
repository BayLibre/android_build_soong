      "writtenOn": "2017-08-23T22:21:11Z",
      "side": 1,
      "message": "Why do we need both this and LOCAL_VNDK_PRIVATE?",
      "revId": "80b3253d739c18bb5a665f48a1f6250636ed31dd",
