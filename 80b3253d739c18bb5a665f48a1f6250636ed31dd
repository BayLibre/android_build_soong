      "writtenOn": "2017-08-24T04:59:23Z",
      "side": 1,
      "message": "no. Bool(...Vendor_available) returns false even when it is not set (for example, a vendor-only lib). we have to filter-out the case. otherwise, vendor-only lib -\u003e vendor-only lib dependency is falsely recognized as a violation.",
      "parentUuid": "16e431fe_7d042fb4",
      "range": {
        "startLine": 87,
        "startChar": 76,
        "endLine": 87,
        "endChar": 154
      },
      "revId": "80b3253d739c18bb5a665f48a1f6250636ed31dd",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
