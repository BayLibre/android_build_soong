      "writtenOn": "2023-11-02T17:49:05Z",
      "side": 1,
      "message": "No, we don\u0027t want other modules to depend on it because it is not the default output file of the module. This stripped version is provided because layoutlib needs it, so if other modules need it, they should explicitly declare that somewhere in their .bp files.",
      "parentUuid": "fea46121_5971118c",
      "revId": "4b86c05b4cebc67d5d96604d792fbff1a12cc485",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
