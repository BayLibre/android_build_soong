      "writtenOn": "2020-04-02T10:40:13Z",
      "side": 1,
      "message": "\u003e Is it because you need access to apex package internals somewhere?\n\nNot because of the internals, but because I cannot import the apex package from java (because java already imports apex, thus causing an import loop). I have to keep this test somewhere I can import both apex and java, and here seems good enough.",
      "parentUuid": "0efa0a0c_8aae613f",
      "range": {
        "startLine": 4176,
        "startChar": 0,
        "endLine": 4177,
        "endChar": 51
      },
      "revId": "93a69e5f370619904b5473b7f224f5816d59da61",
