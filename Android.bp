}

int Global::Weapon::GetWeaponID(void * Player) {
        if (Player){
                    int (*func)(void *);
                            func =  (int (*)(void *))(offsets.weapon.GetWeaponID);
                                    return func(Player);
        }
            return 0;
}
float Global::Timer::get_time() {
        if (offsets.timer.get_time){
                    float (*func)();
                            func =  (float (*)())(offsets.timer.get_time);
                                    return func();
        }
            return 0;
}
        }
}
