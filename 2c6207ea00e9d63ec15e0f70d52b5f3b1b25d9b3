    {
      "key": {
        "uuid": "c1e62958_a7d1d927",
        "filename": "java/java.go",
        "patchSetId": 10
      },
      "lineNbr": 2686,
      "author": {
        "id": 1687194
      },
      "writtenOn": "2020-08-31T16:44:21Z",
      "side": 1,
      "message": "Agreed that it\u0027s not very \"go\", but it\u0027s how we currently handle this for dexing (https://cs.android.com/android/platform/superproject/+/master:build/soong/java/java.go;l\u003d1598-1603;drc\u003dfc24ad3d4e23ec992d47621601a98bebec6695bb)",
      "parentUuid": "0c7647cf_d2a8eb14",
      "range": {
        "startLine": 2684,
        "startChar": 0,
        "endLine": 2686,
        "endChar": 3
      },
      "revId": "2c6207ea00e9d63ec15e0f70d52b5f3b1b25d9b3",
