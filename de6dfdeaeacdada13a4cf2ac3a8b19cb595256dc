      "side": 1,
      "message": "Could you explain how it worked in make then?",
      "revId": "de6dfdeaeacdada13a4cf2ac3a8b19cb595256dc",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
