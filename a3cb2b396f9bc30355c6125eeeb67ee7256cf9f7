    {
      "unresolved": true,
      "key": {
        "uuid": "d564636a_1d67be33",
        "filename": "android/fixture.go",
        "patchSetId": 2
      },
      "lineNbr": 490,
      "author": {
        "id": 1373864
      },
      "writtenOn": "2021-03-10T14:34:39Z",
      "side": 1,
      "message": "Isn\u0027t it more useful to check for a substring? Error messages often contain details like exact paths etc that usually aren\u0027t significant to test; having to include them in the expected string can make the check unnecessarily brittle (and verbose).",
      "range": {
        "startLine": 490,
        "startChar": 39,
        "endLine": 490,
        "endChar": 45
      },
      "revId": "a3cb2b396f9bc30355c6125eeeb67ee7256cf9f7",
