      "writtenOn": "2024-03-11T08:22:16Z",
      "side": 1,
      "message": "Why is bar included in NDK? Its tag doesn\u0027t say anything about ndk.",
      "range": {
        "startLine": 24,
        "startChar": 0,
        "endLine": 24,
        "endChar": 27
      },
      "revId": "d298dc85b10463c1c1257286feddb6f8f9ebe1ef",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
