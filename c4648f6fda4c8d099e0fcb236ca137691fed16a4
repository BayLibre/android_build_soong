      "writtenOn": "2023-10-16T15:22:22Z",
      "side": 1,
      "message": "Colin, should I switch to using a single \" \", abandon this change or maybe make it configurable somehow?",
      "parentUuid": "b2af6745_6a3b372d",
      "revId": "c4648f6fda4c8d099e0fcb236ca137691fed16a4",
