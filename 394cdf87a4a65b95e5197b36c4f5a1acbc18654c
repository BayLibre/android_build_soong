      },
      "lineNbr": 218,
      "author": {
        "id": 1047769
      },
      "writtenOn": "2018-12-03T22:32:46Z",
      "side": 1,
      "message": "The primary use I\u0027m adding this for is for use by go/art-apex-update-e2e in the cloud. There is no need for image apex\u0027s in this situation.\n\nAlso in other situations (like cc_binary) generally we seem to go with allowing the full space of possibilities.\n\nChanged name to \"Payload_type\"",
      "parentUuid": "38aa6f8b_67d6e4fd",
      "range": {
        "startLine": 218,
        "startChar": 1,
        "endLine": 218,
        "endChar": 6
      },
