      "side": 1,
      "message": "Why do we only check \"srcs\" for the static library module?",
      "range": {
        "startLine": 305,
        "startChar": 3,
        "endLine": 305,
        "endChar": 34
      },
      "revId": "dd99f82c4305cccfb6626852ad6d9b3436830c80",
