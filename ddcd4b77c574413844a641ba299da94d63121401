        "id": 1039338
      },
      "writtenOn": "2020-12-15T20:51:57Z",
      "side": 1,
      "message": "I was following a suggestion of Ulya\u0027s for tests which I found useful. I don\u0027t really see the benefit of using a comment. It requires more typing (no completion) and doesn\u0027t provide any additional information.",
      "parentUuid": "c849f314_5ff77aef",
      "range": {
        "startLine": 2209,
        "startChar": 0,
        "endLine": 2210,
        "endChar": 33
      },
      "revId": "ddcd4b77c574413844a641ba299da94d63121401",
