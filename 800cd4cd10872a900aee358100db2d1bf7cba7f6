      "writtenOn": "2020-10-13T19:03:48Z",
      "side": 1,
      "message": "Doesn\u0027t partial analysis in Bazel mean that it may not have read many of these files?  Would it be possible to have Bazel report the files that it actually read, the same way that clang reports headers in a .d file?",
      "range": {
        "startLine": 9,
        "startChar": 0,
        "endLine": 11,
        "endChar": 0
      },
      "revId": "800cd4cd10872a900aee358100db2d1bf7cba7f6",
