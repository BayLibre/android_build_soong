      "writtenOn": "2021-02-23T20:33:13Z",
      "side": 1,
      "message": "The UseArtImage is intended to be used for preopting apps differently than the normal config, where we preopt with the entire boot image (art + framework).\n\nThis code can be deprecated though, and you can feel free to remove the entire UseArtImage logic on the build.",
      "parentUuid": "cb80b6a4_1b352091",
      "revId": "40139d6422114672770fc9051c346f8f1aba79d9",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
