    {
      "key": {
        "uuid": "03c268fb_72bdd90d",
        "filename": "android/config.go",
        "patchSetId": 2
      },
      "lineNbr": 1259,
      "author": {
        "id": 1039338
      },
      "writtenOn": "2020-07-21T12:43:55Z",
      "side": 1,
      "message": "The name is not particularly informative. I have been trying to think of a better name. The trick is to balance between being too specific that means adding new information will require renaming and too general. I am not sure that the location is such a key part of this that it needs to be in the name.\n\nConceptually it is a list of information about jars provided by the configuration.\n\nHow about ConfiguredJarList? Is that too general?",
      "parentUuid": "783805a8_407eee64",
      "range": {
        "startLine": 1259,
        "startChar": 5,
        "endLine": 1259,
        "endChar": 8
      },
      "revId": "3516e7f517ad048b4b55d5bba9245b923423fc57",
