      "writtenOn": "2019-05-06T22:43:07Z",
      "side": 1,
      "message": "This seems really messy.  Would it be better to annotate modules that need to go into the bootstrap directory manually?",
      "revId": "42b8eb3a54cbef297802be3775efca1ae2749a39",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
