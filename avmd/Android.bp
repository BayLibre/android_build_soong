        "soong-android",
        "soong-apex",
        "soong-filesystem",
        "soong-java",
    ],
    srcs: [
        "avmd.go",
    ],
    //    testSrcs: [
    //        "avmd_test.go",
    //    ],
    pluginFor: ["soong_build"],
}
