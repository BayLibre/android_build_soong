    {
      "key": {
        "uuid": "0e4857d3_3751cbee",
        "filename": "ui/build/config.go",
        "patchSetId": 3
      },
      "lineNbr": 836,
      "author": {
        "id": 1465028
      },
      "writtenOn": "2020-08-12T16:31:49Z",
      "side": 1,
      "message": "I went back and forth about this a lot. My thought is that FLAG_ is still being used in CI and in rbesetup.sh, so I\u0027m not comfortable cutting it out here, especially that this code will apply the default value to RBE_* variable if no existing value is set. So if you have FLAG_ set somewhere, it will silently be ignored and superseded with the default RBE_ and that would be confusing behavior.",
      "parentUuid": "e3c580c0_e85dcb11",
      "range": {
        "startLine": 836,
        "startChar": 46,
        "endLine": 836,
        "endChar": 60
      },
      "revId": "a4957dd3f2e7cd55584e2d5ae3214368c4367ebd",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
