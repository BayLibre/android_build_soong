        "id": 1514973
      },
      "writtenOn": "2020-08-12T13:44:55Z",
      "side": 1,
      "message": "Do we have to support `FLAG_*` variables going forward? If we want to deprecate them at some point, lets maybe ensure we don\u0027t add support for it in new code?",
      "range": {
        "startLine": 836,
        "startChar": 46,
        "endLine": 836,
        "endChar": 60
      },
      "revId": "a4957dd3f2e7cd55584e2d5ae3214368c4367ebd",
